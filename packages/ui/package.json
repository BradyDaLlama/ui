{
    "name": "@bradydallama/ui",
    "version": "0.1.0",
    "description": "Outlined, pill-shaped React components from the bradydallama design system.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BradyDaLlama/ui.git",
        "directory": "packages/ui"
    },
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./motion": {
            "types": "./dist/motion/index.d.ts",
            "import": "./dist/motion/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@bradydallama/tokens": "^0.1.0"
    },
    "peerDependencies": {
        "gsap": "^3.13.0",
        "react": "^18.3.0 || ^19.0.0",
        "react-dom": "^18.3.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "gsap": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.2.0",
        "gsap": "^3.15.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    }
}
